# kernel-fork-lab: the kernel for unkernel-rs, both images.
#
# The Worker boots one kernel either way; only the initrd differs:
#
#   minimal (./build.sh)           /init (guest/init/init.c) mounts devtmpfs,
#                                 proc, sysfs, tmpfs, brings loopback up and
#                                 runs /usr/bin/kwtty; the SDK spawns
#                                 /hello/axum-hello, a static aarch64 musl axum
#                                 server on 127.0.0.1:3000, and proxies to it.
#   shell (WITH_SHELL=1 ./build.sh) the SDK package's base userland: a busybox
#                                 /init (a shebang script), the kw layer's rc
#                                 (devpts, /dev/shm, cgroup2, binfmt_misc),
#                                 kwtty respawned by inittab, a shell on hvc0.
#
# So: BINFMT_SCRIPT, AF_UNIX and devpts stay (the base init is "#!/bin/busybox
# sh", and kwtty and the rc scripts use unix sockets); the pieces below go,
# because neither image mounts a disk, has a display, audio, input, a network
# interface other than loopback, or runs a service manager.
#
# Measured: this fragment took the minimal image's module from 4,438,054 to
# 3,517,686 bytes and the shell image's from 5,215,525 to 4,295,157 (the fork's
# vmlinux32.wasm, before the initrd is cut: 5,216,369 -> 4,116,815). The
# proc/sysfs/devtmpfs/tmpfs mounts, loopback/TCP, vsock, ELF exec, pty support
# and the guest's file I/O are untouched.

# --- process/memory interfaces a single-purpose guest never asks for --------
# no systemd, no containers, no ps/top accounting, nothing reads /proc/pressure
# or /proc/PID/io
# CONFIG_SYSVIPC is not set
# CONFIG_POSIX_MQUEUE is not set
# CONFIG_CGROUPS is not set
# CONFIG_CGROUP_PIDS is not set
# CONFIG_NAMESPACES is not set
# CONFIG_USER_NS is not set
# CONFIG_KCMP is not set
# CONFIG_USERFAULTFD is not set
# CONFIG_CHECKPOINT_RESTORE is not set
# CONFIG_PSI is not set
# CONFIG_TASKSTATS is not set
# CONFIG_TASK_XACCT is not set
# CONFIG_TASK_IO_ACCOUNTING is not set
# CONFIG_TIME_NS is not set
# CONFIG_BINFMT_MISC is not set

# --- loopback only: no packet sockets, no DHCP, no policy routing -----------
# the SDK reaches the guest through kwtty (vsock), so there is no virtio net.
# CONFIG_PACKET is not set
# CONFIG_PACKET_DIAG is not set
# CONFIG_UNIX_DIAG is not set
# CONFIG_NETLINK_DIAG is not set
# CONFIG_IP_MULTICAST is not set
# CONFIG_IP_ADVANCED_ROUTER is not set
# CONFIG_IP_MULTIPLE_TABLES is not set
# CONFIG_VSOCKETS_DIAG is not set
# CONFIG_KWNET is not set
# CONFIG_DUMMY is not set
# CONFIG_VETH is not set
# CONFIG_TUN is not set
# CONFIG_ETHERNET is not set

# --- no disks at all: no data disk, no distro image, no data modules --------
# neither image attaches one; the root is the initramfs and /dev, /proc, /sys,
# /run, /tmp are memory-backed. CONFIG_BLOCK goes too: the boot log's
# "io scheduler mq-deadline/kyber registered" were its only users.
# CONFIG_BLOCK is not set
# CONFIG_BLOCK_LEGACY_AUTOLOAD is not set
# CONFIG_BLK_DEV is not set
# CONFIG_BLK_DEV_WRITE_MOUNTED is not set
# CONFIG_MQ_IOSCHED_DEADLINE is not set
# CONFIG_MQ_IOSCHED_KYBER is not set
# CONFIG_BLK_DEV_LOOP is not set
# CONFIG_BLK_DEV_LOOP_MIN_COUNT is not set
# CONFIG_BLK_DEV_KWBLK is not set
# CONFIG_EXT4_FS is not set
# CONFIG_EXT4_FS_POSIX_ACL is not set
# CONFIG_EXT4_FS_SECURITY is not set
# CONFIG_FANOTIFY is not set
# CONFIG_AUTOFS_FS is not set
# CONFIG_OVERLAY_FS is not set
# CONFIG_FUSE_FS is not set
# CONFIG_MISC_FILESYSTEMS is not set
# CONFIG_EROFS_FS is not set
# CONFIG_EROFS_FS_XATTR is not set
# CONFIG_EROFS_FS_POSIX_ACL is not set
# CONFIG_EROFS_FS_SECURITY is not set
# CONFIG_EROFS_FS_BACKED_BY_FILE is not set
# CONFIG_EROFS_FS_ZIP is not set
# CONFIG_EROFS_FS_ZIP_ZSTD is not set
# CONFIG_NETWORK_FILESYSTEMS is not set
# CONFIG_NET_9P is not set
# CONFIG_NET_9P_FD is not set
# CONFIG_9P_FS is not set

# --- no display, sound, input, virtio or DRM: a Worker has no page ----------
# CONFIG_INPUT is not set
# CONFIG_INPUT_EVDEV is not set
# CONFIG_INPUT_KWINPUT is not set
# CONFIG_FB is not set
# CONFIG_FB_KWFB is not set
# CONFIG_SOUND is not set
# CONFIG_SND is not set
# CONFIG_SND_OSSEMUL is not set
# CONFIG_SND_PCM_OSS is not set
# CONFIG_SND_KWSND is not set
# CONFIG_VIRTIO_MENU is not set
# CONFIG_KWVIRTIO is not set
# CONFIG_DRM is not set
# CONFIG_DRM_VIRTIO_GPU is not set
# CONFIG_DRM_VIRTIO_GPU_KMS is not set
# CONFIG_KWSHM is not set
# CONFIG_MAGIC_SYSRQ is not set

# --- size: the module is mostly this kernel ---------------------------------
# -Os instead of -O2: the Worker downloads every byte of this module, and the
# kernel is ~2/3 of it (the initrd is already gzip). Measured against -O2 over
# 1000-request A/B runs: the guest request path is unchanged (p50 0.40 ms both,
# same p90/min); boot gets faster with the smaller module.
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
# CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE is not set

# printk's ring buffer is *static* memory: at the default 128 KiB, the records
# and descriptor arrays are 448 KiB of the module's data section (almost all
# zeros). Neither image reads /dev/kmsg, dmesg or pstore, and printk still
# writes every message to hvc0 as it is logged, so the boot log and panic
# output are unchanged; only the retained history shrinks to 16 KiB.
CONFIG_LOG_BUF_SHIFT=14

# --- interfaces neither image has a program for ------------------------------
# /init brings loopback up with SIOCSIFFLAGS (ioctl, not rtnetlink); nothing
# speaks sock_diag, POSIX AIO, file leases, dnotify, /dev/mem, or errno-name
# formatting. The app is a static Rust binary on loopback; it never flocks or
# opens a leased file. (CONFIG_BPF itself stays: CONFIG_NET selects it.)
# CONFIG_INET_DIAG is not set
# CONFIG_INET_TCP_DIAG is not set
# CONFIG_AIO is not set
# CONFIG_FHANDLE is not set
# CONFIG_DNOTIFY is not set
# CONFIG_DEVMEM is not set
# CONFIG_IOMMU_SUPPORT is not set
# CONFIG_SYMBOLIC_ERRNAME is not set
# CONFIG_FILE_LOCKING is not set
# CONFIG_SLUB_DEBUG is not set
# CONFIG_VM_EVENT_COUNTERS is not set
# CONFIG_PROC_PAGE_MONITOR is not set
# CONFIG_PROC_CHILDREN is not set
# CONFIG_COMPACTION is not set
# CONFIG_DMA_SHARED_BUFFER is not set
# CONFIG_SYNC_FILE is not set
# CONFIG_TMPFS_XATTR is not set
# CONFIG_TMPFS_POSIX_ACL is not set
# CONFIG_FS_POSIX_ACL is not set

# --- hardening that costs module bytes ---------------------------------------
# wasm locals already start zeroed; zeroing every on-stack array again is
# stores in every kernel function. There is no untrusted code in the isolate
# (the guest userland is packed into this same module), so the stale-stack
# infoleak this hardening closes has no attacker to serve.
# CONFIG_INIT_STACK_ALL_ZERO is not set
CONFIG_INIT_STACK_NONE=y
