{
  "name": "unkernel-rs",
  "version": "0.1.0",
  "description": "A Rust + Axum hello world in Cloudflare Workers, running inside a Linux kernel compiled to WebAssembly (unkernel)",
  "type": "module",
  "private": true,
  "scripts": {
    "assets": "./build.sh",
    "build": "npm run assets && cf build",
    "dev": "node scripts/patch-sdk.mjs && cf dev",
    "deploy": "npm run assets && cf deploy",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "cf": "^1.0.0-rc.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.166.0"
  },
  "dependencies": {
    "unkernel": "0.2.0-261121-e69adda"
  }
}